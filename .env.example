# --- Mantle network ---
# Flip between "mainnet" and "sepolia" to switch chains.
MANTLE_NETWORK=mainnet
MANTLE_MAINNET_RPC=https://rpc.mantle.xyz
MANTLE_SEPOLIA_RPC=https://rpc.sepolia.mantle.xyz

# --- Polling ---
# How often the background task reads INIT Capital state, in seconds.
POLL_INTERVAL_SECONDS=30

# Cap on positions to read per cycle (None/0 = unlimited). Useful for testing.
MAX_POSITIONS_PER_CYCLE=0

# --- MongoDB ---
# Connection string for the MongoDB instance.
MONGO_URI=mongodb://localhost:27017
MONGO_DB_NAME=cascade

# --- API ---
API_HOST=0.0.0.0
API_PORT=8000

# --- Logging ---
LOG_LEVEL=INFO
LOG_FORMAT=json

# --- Cascade detection ---
# Health-factor threshold below which a position counts as at-risk.
CASCADE_AT_RISK_HF=1.15
# Minimum cluster size to flag a cascade zone.
CASCADE_MIN_CLUSTER_SIZE=3

# --- Multi-protocol support ---
# Toggle reading Lendle (Aave V2 fork) alongside INIT Capital.
ENABLE_LENDLE=true
# How many blocks back to scan for Lendle Borrow events on first discovery.
# 50000 ≈ 28 hours on Mantle. Bigger window = more borrowers, slower start.
LENDLE_DISCOVERY_BLOCK_WINDOW=50000

# --- Discord alerts ---
# Webhook URL — empty = alerts disabled but pipeline keeps running.
DISCORD_WEBHOOK_URL=
# Seconds before a deduplicated alert can re-fire (shared across Discord + Telegram).
ALERT_DEDUP_WINDOW_SECONDS=600

# --- Telegram alerts ---
# Bot token from @BotFather. Empty = Telegram disabled; Discord still works.
TELEGRAM_BOT_TOKEN=
# Numeric chat id (channel/group/DM). Channels are usually negative
# (e.g. -1001234567890). Find via: curl https://api.telegram.org/bot<TOKEN>/getUpdates
TELEGRAM_CHAT_ID=

# --- Phase 4: on-chain logger (Mantle Sepolia) ---
# Throwaway deployer key — get test MNT from https://faucet.sepolia.mantle.xyz
SEPOLIA_DEPLOYER_PRIVATE_KEY=
# Set this AFTER running contracts/script/deploy.py (it prints the address).
CASCADE_LOGGER_ADDRESS=
